#!/bin/sh
# Generated by Ansible (ninux_build_openwrt role)
#
# /etc/hotplug.d/openwisp: dopo ogni applicazione della configurazione
# OpenWISP ricarica uhttpd. Serve per i certificati che arrivano come file dei
# template (portale uspot in HTTPS sulla 3990): al boot uhttpd parte prima
# dell'agente, l'istanza senza certificato non apre nessun socket ("No sockets
# bound"), procd la ferma come crash loop e l'agente non la ricarica, perche'
# /etc/config/uhttpd non e' cambiato. Il reload riavvia solo le istanze la cui
# riga di comando o i cui file sono cambiati: LuCI non si interrompe.
[ "$ACTION" = "post-reload" ] || exit 0
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd reload
exit 0
