#!/bin/sh
# Generated by Ansible (ninux_build_openwrt role)
# Password di root di default (da ninux.yml, openwrt_root_password).
# Solo l'hash finisce nel firmware, mai la password in chiaro.
#
# Solo se root non ha una password (primo flash da firmware originale o dopo
# un reset): gli uci-defaults girano dopo OGNI flash, anche con la
# configurazione conservata, e altrimenti sovrascriverebbero la password
# scelta sul router.

[ -n "$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)" ] && exit 0

sed -i 's#^root:[^:]*:#root:{{ openwrt_root_password | password_hash('sha512_crypt') }}:#' /etc/shadow

exit 0
