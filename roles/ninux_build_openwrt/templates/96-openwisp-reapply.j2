#!/bin/sh
# Generated by Ansible (ninux_build_openwrt role)
#
# Dopo un sysupgrade con la configurazione conservata, openwisp-config ritrova
# /etc/openwisp/ (checksum compreso) e non riapplica niente: ma sysupgrade
# conserva solo i file di configurazione dei pacchetti, non quelli che i
# template OpenWISP scrivono altrove (certificati in /etc/uspot, script e
# chiave del DDNS, /etc/ninux-hosts, hotplug di netconsole...). Sul
# WRT3200ACM, novembre 2026: uhttpd del portale HTTPS in crash loop ("No
# sockets bound", certificato mancante) e cron del DDNS in errore ogni 5
# minuti.
#
# Senza checksum l'agente, al primo controllo, riscarica la configurazione e
# la riapplica tutta, file compresi. Gli uci-defaults girano anche al primo
# avvio dopo un'installazione da zero: li' il checksum non c'e' e non cambia
# niente.
rm -f /etc/openwisp/checksum
exit 0
