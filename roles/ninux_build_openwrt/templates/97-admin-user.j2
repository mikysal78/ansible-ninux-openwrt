#!/bin/sh
# Generated by Ansible (ninux_build_openwrt role)
# Utente "admin" con UID 0: accesso di servizio NINUX (SSH e LuCI), con la
# password di ninux.yml (openwrt_admin_password). Solo l'hash finisce nel
# firmware, mai la password in chiaro.
#
# A differenza di root (password di default che resta se cambiata sul
# router), la password di admin si reimposta a OGNI flash: e' l'accesso che
# deve restare sempre quello di NINUX.

grep -q '^admin:' /etc/passwd || echo 'admin:x:0:0:admin:/root:/bin/ash' >>/etc/passwd
grep -q '^admin:' /etc/shadow || echo 'admin:::0:99999:7:::' >>/etc/shadow

sed -i 's#^admin:[^:]*:#admin:{{ openwrt_admin_password | password_hash('sha512_crypt') }}:#' /etc/shadow

# LuCI passa da rpcd: senza una sezione login per admin il login web fallisce.
# '$p$admin' = usa la password di sistema dell'utente admin.
if ! uci -q get rpcd.admin >/dev/null; then
	uci set rpcd.admin=login
	uci set rpcd.admin.username='admin'
	uci set rpcd.admin.password='$p$admin'
	uci add_list rpcd.admin.read='*'
	uci add_list rpcd.admin.write='*'
	uci commit rpcd
fi

exit 0
