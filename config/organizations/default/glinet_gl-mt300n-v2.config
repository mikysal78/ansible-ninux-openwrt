# Router
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_glinet_gl-mt300n-v2=y

# LuCI senza Bootstrap, per la flash da 16 MB: luci-theme-ninux dipende da
# tutto quello che porta luci-light tranne luci-theme-bootstrap. Al posto di
# luci-ssl i suoi pacchetti, senza luci-light.
CONFIG_PACKAGE_luci-theme-ninux=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_px5g-mbedtls=y
CONFIG_PACKAGE_luci-app-package-manager=y
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-ssl is not set
# CONFIG_PACKAGE_luci-light is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
