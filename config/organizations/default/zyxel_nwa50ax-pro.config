# Router
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_zyxel_nwa50ax-pro=y

# LuCI completa (luci-ssl: HTTPS e gestione pacchetti) con il tema ninux, che
# diventa il predefinito; Bootstrap resta come tema di riserva
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-ninux=y
