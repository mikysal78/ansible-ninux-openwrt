# Router
CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_linksys_wrt3200acm=y

CONFIG_PACKAGE_python3-speedtest-cli=y

# LuCI completa (luci-ssl: HTTPS e gestione pacchetti) con il tema ninux, che
# diventa il predefinito; Bootstrap resta come tema di riserva
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-ninux=y
