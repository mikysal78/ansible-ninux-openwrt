# Router
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_glinet_gl-mt300n-v2=y

# LuCI completa con Bootstrap di riserva, come sugli altri router: tolto
# bind-client (~2,9 MB) lo spazio c'e', Bootstrap pesa 19 KB.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-ninux=y

# Chiavi SSH ed25519: su mt76x8 (small_flash) dropbear le esclude di default
# e rifiuta le chiavi del template "SSH Keys" (OpenWISP e admin, entrambe
# ed25519): OpenWISP non entra e non puo' aggiornare il firmware. Pochi KB.
CONFIG_DROPBEAR_ED25519=y
