# Router
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_totolink_x5000r=y
CONFIG_PACKAGE_python3-speedtest-cli=m

# LuCI completa (luci-ssl: HTTPS e gestione pacchetti) con il tema ninux, che
# diventa il predefinito; Bootstrap resta come tema di riserva
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-ninux=y
