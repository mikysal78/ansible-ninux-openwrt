# Router
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_GRUB_TITLE="Ninux"

CONFIG_PACKAGE_luci-app-openwisp=y
CONFIG_PACKAGE_luci-app-wireguard=y

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y

CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_block-mount=m

CONFIG_PACKAGE_rt2800-pci-firmware=y
CONFIG_PACKAGE_kmod-rt2800-pci=y
CONFIG_PACKAGE_rt2800-usb-firmware=y
CONFIG_PACKAGE_kmod-rt2800-usb=y

CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11N_SUPPORT=y
CONFIG_PACKAGE_MAC80211_DEBUGFS=y
CONFIG_PACKAGE_MAC80211_MESH=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-vxlan=y

CONFIG_PACKAGE_kmod-pptp=y
CONFIG_PACKAGE_pptpd=y
CONFIG_PACKAGE_ppp-mod-pptp=y
CONFIG_PACKAGE_luci-proto-ppp=y

CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_luci-app-banip=y

# Debug blocchi (schede Intel I226-V / igc): watchdog hardware, log kernel via rete.
# Watchdog: su Gemini Lake iTCO_wdt non trova il TCO (verificato sul router dopo
# il flash della build #25), quindi kmod-wdat-wdt (tabella ACPI WDAT), pacchetto
# Ninux in roles/ninux_build_openwrt/files/packages/. NON si carica al boot: va
# provato a mano prima di abilitarlo (vedi il Makefile).
CONFIG_PACKAGE_kmod-wdat-wdt=y
CONFIG_PACKAGE_kmod-netconsole=y

# Blocchi completi del sistema (13-14/10: prima cade la WAN, poi nessun messaggio
# del kernel). Gemini Lake (J4125): disattivare i C-state via sysfs dopo il boot
# (/root/logs/cstate-limit.sh) non e' bastato, max_cstate=1 dal boot limita anche
# quelli del package. Finisce in grub.cfg (anche con l'IB).
# Gia' esclusi sul router: ASPM (disattivato dal BIOS su tutti i link) ed EEE
# (spento di default dal driver igc), quindi niente pcie_aspm=off/ethtool.
CONFIG_GRUB_BOOTOPTS="intel_idle.max_cstate=1"

# Rilevatori di lockup: entrano nel kernel del seed, quindi valgono anche con l'ImageBuilder
CONFIG_KERNEL_SOFTLOCKUP_DETECTOR=y
CONFIG_KERNEL_DETECT_HUNG_TASK=y
# NIENTE KERNEL_HARDLOCKUP_DETECTOR: su OpenWrt 25.12 (kernel 6.12) lascia senza
# valore HARDLOCKUP_DETECTOR_PREFER_BUDDY e kconfig si ferma a chiederlo (build
# #23 fallita in syncconfig). Gli hard lockup li copre il watchdog iTCO (riavvio).
