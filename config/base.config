# enable image builder
CONFIG_IB=y
CONFIG_IB_STANDALONE=y

# avoid broken feeds in /etc/opkg/distfeeds.conf
# CONFIG_FEED_openwisp_config is not set
# CONFIG_FEED_openwisp_monitoring is not set

# additional packages
CONFIG_PACKAGE_wget=y
# partx-utils (con libblkid e libsmartcols ~210 KB) sta solo nelle config
# x86, dove lo usa il sysupgrade: sui router non serve.
CONFIG_PACKAGE_bird3=y
# niente bird3c (birdc): readline e ncurses, ~270 KB. Stessi comandi con
# birdcl, che usa anche il feed della topologia sul server OpenWISP.
# CONFIG_PACKAGE_bird3c is not set
CONFIG_PACKAGE_bird3cl=y
CONFIG_PACKAGE_librt=y
# LuCI NON sta qui ma nella config di ogni device: la build appende questo
# file DOPO quella del device, quindi un "is not set" messo lì per togliere
# Bootstrap (GL-MT300N-V2, poca flash) verrebbe sovrascritto.
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ipip=y
CONFIG_PACKAGE_kmod-ipip=y
# netconsole: log del kernel in tempo reale via UDP al server OpenWISP
# (template OpenWISP "Netconsole"). Compilato con NETCONSOLE_DYNAMIC
# (clone_openwrt.yml) per l'userdata con il nome del device: si porta dietro
# kmod-fs-configfs
CONFIG_PACKAGE_kmod-netconsole=y
CONFIG_PACKAGE_kmod-fs-configfs=y
# usteer: coordina gli AP con le stesse reti (es. i due Zyxel di
# ReginaMargherita116) e sposta i client sull'AP con il segnale migliore
# (802.11v o, per chi non lo supporta, disconnessione sotto soglia). Con un
# solo AP resta inattivo. Configurazione dal template OpenWISP "usteer".
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_lua-cjson=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_lua-cjson=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# openwisp2 related packages
CONFIG_PACKAGE_openwisp-config=y
CONFIG_PACKAGE_netjson-monitoring=y
CONFIG_PACKAGE_openwisp-monitoring=y

# other configurations
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_SAVE_ON_EXIT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VI_UNDO=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SH_HISTFILESIZE=y
CONFIG_BUSYBOX_CONFIG_WATCH=y

# allow to build curl with different ssl library
CONFIG_LIBCURL_MBEDTLS=y

# Mesh
CONFIG_PACKAGE_mesh11sd=m

# WirelessAPD
# wpad-mesh-*: serve il supporto 802.11s (mesh wireless) + SAE (WPA3).
# mbedtls invece di wolfssl/openssl: stesso backend crypto gia' usato per
# curl (CONFIG_LIBCURL_MBEDTLS sopra), una sola libreria crypto nel firmware
# invece di due. openssl (il piu' pesante) va rimosso: era ridondante, la
# build reale seleziona comunque solo una variante di wpad.
CONFIG_PACKAGE_wpad-mesh-mbedtls=y

# DDNS: niente bind-client (nsupdate). Portava bind-libs e OpenSSL, ~2,9 MB
# compressi. Il DDNS della zona dyn.ninux-nnxx.it lo fa il server OpenWISP
# (openwisp2/files/sync_ddns.py) dal 06/11/2026.
