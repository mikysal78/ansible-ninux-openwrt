#!/bin/sh
# Zona firewall "ninux" per le interfacce gestite da OpenWISP (management + mesh).
#
# I file in /etc/uci-defaults/ girano al primo boot E DOPO OGNI SYSUPGRADE che
# conserva la configurazione (poi vengono rimossi, se ritornano 0).
#
# Perche' serve: ZeroTier (owzt0d3e97, management + mesh Babel) e mesh
# (br-mesh, 802.11s) le crea OpenWISP/uci DOPO il primo boot; senza una zona che
# le contenga cadono nella policy di input REJECT dell'immagine base e il router
# rifiuta tutto in ingresso (il monitoring non lo pinga, Babel non peera).
# La zona puo' riferirsi a reti non ancora esistenti: quando l'interfaccia sale,
# netifd ricarica il firewall e la aggancia da sola.
#
# Zona completamente aperta (input/output/forward ACCEPT) con forwarding
# bidirezionale verso la lan, cosi' anche i client degli AP entrano nel mesh.
# Named-section idempotente: rieseguire lo script non duplica nulla.

# Solo su un'installazione nuova: se esistono gia' le zone 'VPN'/'mesh' che crea
# il post-reload-hook del template OpenWISP Bird, il router e' gia' configurato.
# Ricreare 'ninux' a ogni sysupgrade metteva 'mesh' in due zone finche' il hook
# non la toglieva al primo apply.
for s in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
	case "$(uci -q get "firewall.$s.name")" in VPN|mesh) exit 0 ;; esac
done

uci -q batch <<'EOF'
set firewall.ninux=zone
set firewall.ninux.name='ninux'
set firewall.ninux.input='ACCEPT'
set firewall.ninux.output='ACCEPT'
set firewall.ninux.forward='ACCEPT'
delete firewall.ninux.network
add_list firewall.ninux.network='ZeroTier'
add_list firewall.ninux.network='mesh'
set firewall.ninux_lan=forwarding
set firewall.ninux_lan.src='ninux'
set firewall.ninux_lan.dest='lan'
set firewall.lan_ninux=forwarding
set firewall.lan_ninux.src='lan'
set firewall.lan_ninux.dest='ninux'
commit firewall
EOF

exit 0
